            </p>

            <button
              class="open-btn"
              onclick="openPractical('Code Editor')"
            >
              Open →
            </button>

          </div>


          <div class="practical-card">

            <div class="practical-icon">
              🖥️
            </div>

            <h3>
              Computer Workshop
            </h3>

            <p>
              Complete guided computer and technology
              practical exercises.
            </p>

            <button
              class="open-btn"
              onclick="openPractical('Computer Workshop')"
            >
              Open →
            </button>

          </div>

        </div>

      </div>

    </div>

  </main>


  <script>

    /* =========================
       MOBILE SIDEBAR
    ========================= */

    const mobileMenu =
      document.getElementById("mobileMenu");

    const sidebar =
      document.getElementById("sidebar");

    mobileMenu.addEventListener("click", () => {

      sidebar.classList.toggle("open");

    });


    /* =========================
       DEMO STUDENT DATA
    ========================= */

    /*
      Later this information will come
      from Firebase Authentication
      and Firestore.

      Example:

      {
        firstName: "Viateur",
        lastName: "Irasubiza",
        role: "student"
      }
    */

    const student = {
      firstName: "Student",
      lastName: ""
    };


    document.getElementById("studentName")
      .textContent =
      student.firstName + " " + student.lastName;

    document.getElementById("welcomeName")
      .textContent =
      student.firstName;

    document.getElementById("avatar")
      .textContent =
      student.firstName
        .charAt(0)
        .toUpperCase();


    /* =========================
       PRACTICAL TOOLS
    ========================= */

    function openPractical(tool) {

      alert(
        tool +
        " will open from the Practical Learning dashboard."
      );

    }


    /* =========================
       FIREBASE PLACEHOLDER
    ========================= */

    /*
      Later this dashboard will load:

      - enrolled courses
      - course progress
      - completed quizzes
      - test results
      - certificates
      - badges
      - practical tasks
      - notifications

      directly from Firestore.

      No fake permanent data will be used
      in the final production version.
    */

  </script>

</body>
</html>
