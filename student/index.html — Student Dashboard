              </span>

            </div>

          </div>


          <div class="activity">

            <div class="activity-icon">
              💻
            </div>

            <div class="activity-info">

              <strong>
                Practical Task
              </strong>

              <span>
                No task assigned
              </span>

            </div>

          </div>

        </div>

      </div>


      <!-- PRACTICAL LEARNING -->

      <div class="card">

        <div class="card-header">

          <h2>
            Practical Learning
          </h2>

          <a href="practical.html" class="view-link">
            Open dashboard →
          </a>

        </div>


        <div class="practical-grid">

          <div class="practical-card">

            <div class="practical-icon">
              🤖
            </div>

            <h3>
              Gemini AI Assistant
            </h3>

            <p>
              Get learning assistance and explanations
              for difficult technology concepts.
            </p>

            <button
              class="open-btn"
              onclick="openPractical('AI Assistant')"
            >
              Open →
            </button>

          </div>


          <div class="practical-card">

            <div class="practical-icon">
              ⌨️
            </div>

            <h3>
              Online Code Editor
            </h3>

            <p>
              Practice programming and experiment
